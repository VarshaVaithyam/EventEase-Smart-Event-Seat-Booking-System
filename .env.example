# =============================================================================
# EventEase — Local & Production Environment Variables Template
# Copy variables to your OS shell, VS Code launch.json, or cloud host settings
# =============================================================================

# --- Server ---
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0

# --- PostgreSQL Database ---
DB_URL=jdbc:postgresql://localhost:5432/eventbooking
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# --- JWT Security (Replace with a strong 64+ character secret in production) ---
JWT_SECRET=EventEaseLocalDevJwtSecretKey2026CardinalityAssessmentSecureKey64Bytes!
JWT_EXPIRATION_MS=86400000

# --- CORS & Seed Data ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
SEED_ENABLED=true

# --- Google Gemini AI (Optional — falls back cleanly if omitted) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
